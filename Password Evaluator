#include <iostream>

int main(){

    float score = 0;

    std::string capitals_ = "ABCDEFGHIJKLMNOPQRSTUVWXYZ";
    std::string specials_ = R"(!"£$%^&*()-=_+[]{};',.<>:@/?#~¬`)";
    std::string nums_ = "1234567890";

    std::string passw;
    std::cout << "Enter password: ";
    std::getline(std::cin, passw);

    
    int len = passw.length();

    int capitals = 0;
    int specials = 0;
    int nums = 0;

    for(char char_ : passw){
        if(capitals_.find(char_) != std::string::npos){
            capitals++;
        }else if(specials_.find(char_) != std::string::npos){
            specials++;
        }else if(nums_.find(char_) != std::string::npos){
            nums++;
        }
    }

    std::cout << "Numbers: " << nums << ", Specials: " << specials << ", Capitals: " << capitals << ", Length: " << len << "\n";

    len <= 16 ? score += 3.125*len : score += 50;
    capitals == 0 ? score+=0: capitals == 1 ? score += 16.7 / 2: score += 16.7;
    nums == 0 ? score+=0: nums == 1 ? score += 16.7 / 2: score += 16.7;
    specials == 0 ? score += 0: specials == 1 ? score += 16.7 / 2: score += 16.7;

    score < 100 ? std::cout << "Final score: ~" << score << "%": std::cout << "Final score: 100%";

    return 0;
}
