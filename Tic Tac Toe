                    return toReturn;
                }
            }
        }else if(dif==2){
            int cSymbol;
            symbol == 1? cSymbol = 2 : cSymbol = 1;
            std::vector<int> check = WinMove(grid, cSymbol);
            if(check[0]!=-1){
