int DecWin(int grid[][3]){
    // Horizontal
    for(int i = 0; i < 3; i++){
        for(int j = 0; j < 3; j++){
            if(grid[i][j]==0){
                break;
            }else{
                if(j==2){
                    if((grid[i][1])==(grid[i][0])&&(grid[i][0])==(grid[i][2])){
                        PrintGrid(grid);
                    return grid[i][j];}else{
                        break;
                    }
                }
            }
        }
    }

    // Vertical
    for(int i = 0; i < 3; i++){
        for(int j = 0; j < 3; j++){
            if(grid[j][i]==0){
                break;
            }else{
                if(j==2){
                    if((grid[0][i])==(grid[1][i])&&(grid[1][i])==(grid[2][i])){
                        PrintGrid(grid);
                        return grid[0][i];
                    }else{
                        break;
                    }
                }
            }
        }
    }

    // Diagonal
    if(grid[0][0] == grid[1][1] && grid[1][1] == grid[2][2] && grid[0][0]!=0){
        PrintGrid(grid);
        return grid[0][0];
    }else if(grid[0][2] == grid[1][1] && grid[1][1] == grid[2][0] && grid[0][2]!=0){
        PrintGrid(grid);
        return grid[0][2];
    }

    int zeroCounter = 0;
    for(int i = 0; i < 3; i++){
        for(int j = 0; j < 3; j++){
            if(!grid[i][j]){
                zeroCounter ++;
            }
        }
    }

    if(!zeroCounter){
        return 3;
    }else{
    return 0;}
}

std::vector<int> WinMove(int grid[][3], int symbol){
    
    // Horizontal
    for(int i = 0; i < 3; i++){
        int zeroCount = 0;
        int same = 0;
        int j_;
        for(int j = 0; j < 3; j++){
            grid[i][j] == 0 ? zeroCount++ : zeroCount += 0;
            if(grid[i][j]==0){j_ = j;}
            grid[i][j] == symbol ? same ++ : same += 0;
            if(zeroCount>1){
                break;
            }else if(j==2&&same==2&&zeroCount==1){
                std::vector<int> toReturn = {i, j_};
                return toReturn;
            }
        }
    }

    // Vertical
    for(int i = 0; i < 3; i++){
        int zeroCount = 0;
        int same = 0;
        int j_;
        for(int j = 0; j < 3; j++){
            grid[j][i] == 0 ? zeroCount++ : zeroCount += 0;
            if(grid[j][i]==0){j_ = j;}
            grid[j][i] == symbol ? same ++ : same += 0;
            if(zeroCount>1){
                break;
            }else if(j==2&&same==2&&zeroCount==1){
                std::vector<int> toReturn = {j_, i};
                return toReturn;
            }
        }
    }

    // Diagonal
    int zeroCount = 0;
    int same = 0;
    int i_;
    for(int i = 0; i < 3; i++){
        grid[i][i] == 0 ? zeroCount++ : zeroCount += 0;
        if(grid[i][i] == 0){i_=i;}
        grid[i][i] == symbol ? same ++ : same += 0;
        if(zeroCount>1){
            break;
        }else if(i==2&&same==2&&zeroCount==1){
            std::vector<int> toReturn = {i_, i_};
            return toReturn;
        }
    }

    zeroCount = 0;
    same = 0;
    int j_;

    for(int i = 0; i < 3; i++){
        int j = 2 - i;

        grid[i][j] == 0 ? zeroCount++ : zeroCount += 0;

        if(grid[i][j] == 0){
            i_ = i;
            j_ = j;
        }

        grid[i][j] == symbol ? same++ : same += 0;

        if(zeroCount > 1){
            break;
        }else if(i == 2 && same == 2 && zeroCount == 1){
            std::vector<int> toReturn = {i_, j_};
            return toReturn;
        }
    }

    std::vector<int> toReturn = {-1, -1};
    return toReturn;
}

std::vector<int> GetCor(int index){
    int pMove = index;
    int row;
    int column;
    ! (pMove % 3) ? row = pMove/3 - 1 : row = pMove/3;

    if((pMove==1)||(pMove==4)||(pMove==7)){
        column = 0;
    }else if((pMove==2)||(pMove==5)||(pMove==8)){
        column = 1;
    }else{
        column = 2;
    }
    std::vector<int> toReturn = {row, column};
    return toReturn;
}

