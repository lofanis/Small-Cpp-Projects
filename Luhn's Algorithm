#include <iostream>
#include <vector>
#include <string>

bool LuhnAlgorithm(std::vector<int>& ilist);

int main(){

    std::vector<std::string> list;
    std::vector<int> ilist;
    std::string cardNum;

    std::cout << "Insert Credit Card Number: ";
    std::getline(std::cin, cardNum);

    for(int i = 0; i < (int)cardNum.size(); i++){
        std::string s(1, cardNum[i]);
        list.push_back(s);
    }

    for(std::string item : list){
        int placeholder = std::stoi(item);
        ilist.push_back(placeholder);
    }

    LuhnAlgorithm(ilist) ? std::cout << "The number passed the test." : std::cout << "The number did not pass the test.";

    return 0;
}

bool LuhnAlgorithm(std::vector<int>& ilist){
    std::vector<int> st1;
    int st2 = 0;
    int st3 = 0;

    // Step 1: Doubling.
    for(int i = 14; i >= 0; i-=2){
        if(ilist[i]<5){
            st1.push_back(ilist[i]*2);
        }else{
            st1.push_back(1);
            st1.push_back(ilist[i]*2-10);
        }
        ilist.erase(ilist.begin() + i);

    }

    // Step 2: Addition of step 1.
    for(int i = 0; i < (int)st1.size(); i++){
        st2+=st1[i];
    }

    // Step 3: Collect untouched numbers in a sum.
    for(int i = 0; i < (int)ilist.size(); i++){
        st3 += ilist[i];
    }

    // Step 4: Add both sums.
    st3 += st2;

    // Step 5: Check validity.
    return st3%10==0;
}

