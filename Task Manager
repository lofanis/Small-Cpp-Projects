#include <iostream>
#include <string>
#include <vector>
#include <limits>

void append(std::vector<char>& vector0, std::vector<std::string>& vector1, std::string str);

int main(){

    int choice = 5;
    std::string str;
    std::vector<std::string> tasks;
    std::vector<char> complete;
    bool gameIsOn = true;
    int index;

    std::string num = "12345";

    while(gameIsOn){
        std::cout << "\n=====TO DO LIST=====\n";
        std::cout << "1. Add task" << "\n" << "2. List tasks" << "\n" <<  "3. Complete task" << "\n" <<  "4. Remove task" << "\n" <<  "5. Quit" << "\n";
        while(true){
            std::cout << "\nChoose option (e.g. 1): ";
            std::cin >> choice;
            std::cin.clear();
            if(choice!=0){
                break;
            }else{
                std::cout << "\nInvalid choice.\n";
                std::cin.ignore(std::numeric_limits<std::streamsize>::max(), '\n');
            }
        }

        int size = tasks.size();
        switch(choice){
            case 1:
            std::cout << "\n";
                std::cout << "\nInsert task: ";
                std::cin.ignore(std::numeric_limits<std::streamsize>::max(), '\n');
                std::getline(std::cin, str);
                append(complete, tasks, str);
                break;
            case 2:
                std::cout << "\n";
                
                if(size!=0){
                    for(int i = 0; i < size; i++){
                        std::cout << i + 1 << ". " <<  " [" << complete[i] << "]     " << tasks[i] << "\n";
                    }
                    break;
                }else{
                    std::cout << "The To Do list is empty.\n";
                }
                break;
            case 3:
                index = 0;
                while(true){
                    std::cout << "Insert index: ";
                    std::cin >> index;
                    if(index>size){
                        std::cout << "Index too large.\n";
                        continue;
                    }else if(index<1){
                        std::cout << "Index too small.\n";
                    }else{
                        break;
                    }
                }
                complete[index-1] = 'X';
                break;
            case 4:
                index = 0;
                while(true){
                    std::cout << "Insert index: ";
                    std::cin >> index;
                    if(index>size){
                        std::cout << "Index too large.\n";
                        continue;
                    }else if(index<1){
                        std::cout << "Index too small.\n";
                    }else{
                        break;
                    }
                }
                complete.erase(complete.begin() + (index-1));
                tasks.erase(tasks.begin() + (index-1));
                break;
            case 5:
                gameIsOn = false;
                break;
            default:
                break;
        }
    }

    std::cout << "Thank you for using this application. ";

    return 0;
}

void append(std::vector<char>& vector0, std::vector<std::string>& vector1, std::string str) {
    vector0.push_back('_');
    vector1.push_back(str);
}
